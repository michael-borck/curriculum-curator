# Curriculum Curator Environment Variables
# Copy this file to .env and update with your values

# REQUIRED: Security
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production

# Public domain(s) the app is served from (bare hostnames, comma-separated).
# Required when deploying behind a real domain; leave empty for local dev.
# Example: PUBLIC_DOMAIN=curriculum.example.com
PUBLIC_DOMAIN=

# Database (default is SQLite, can change to PostgreSQL for production)
DATABASE_URL=sqlite:///./data/curriculum_curator.db

# Git Content Repository
CONTENT_REPO_PATH=./content

# LLM Configuration (optional - users can bring their own keys)
# Leave empty to allow users to configure their own keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4

# Email Configuration (optional)
# EMAIL_DEV_MODE=true prints verification/reset codes to the console instead of
# sending. Set it false and pick a provider below to send real email.
EMAIL_DEV_MODE=true

# Provider selects the transport. Options: resend, gmail, brevo, sendgrid,
# mailgun, postmark, custom (generic SMTP), dev (console).
# EMAIL_PROVIDER=resend
# FROM_EMAIL=noreply@your-verified-domain.com   # must be a Resend-verified domain
# FROM_NAME=Curriculum Curator

# --- Resend (HTTP API — simplest; recommended) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key

# --- Resend over SMTP (alternative to the API) ---
# EMAIL_PROVIDER=custom
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend            # literally "resend"
# SMTP_PASSWORD=re_your_api_key
# USE_TLS=true

# --- Brevo (SMTP relay) ---
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# SMTP_USERNAME=your-login@smtp-brevo.com

# Contact email advertised to third-party APIs (CrossRef/OpenAlex polite
# pools). Optional; falls back to FROM_EMAIL.
CONTACT_EMAIL=

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_FILE_UPLOAD=true
DEBUG=false

# Testing
TESTING=false
DISABLE_RATE_LIMIT=false

# Export Tools Paths (usually auto-detected in Docker)
GIT_PATH=/usr/bin/git
PANDOC_PATH=/usr/bin/pandoc
TYPST_PATH=/usr/local/bin/typst
# Ignore frontend build artifacts and cache
frontend/node_modules
frontend/dist
frontend/.vite

# Ignore backend artifacts
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/**/*.pyc
backend/.pytest_cache
backend/.ruff_cache
backend/.mypy_cache

# Ignore data directories
data/
backend/data/
backend/content_repos/

# Ignore git
.git
.gitignore

# Ignore IDE
.vscode
.idea
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Never bake secrets into the image (examples and templates are fine).
.env
**/.env
!**/.env.example

# macOS AppleDouble metadata files
**/._*

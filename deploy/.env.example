# Curriculum Curator — VPS Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env

# ── Security ──────────────────────────────────────────────
# REQUIRED: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Public Domain ─────────────────────────────────────────
# REQUIRED for VPS deployments: the domain(s) the app is served from
# (bare hostnames, comma-separated). Added to the trusted-host and CORS
# allowlists. Localhost is always allowed.
PUBLIC_DOMAIN=curriculum.example.com

# ── Database ──────────────────────────────────────────────
# Absolute path inside container — do NOT change unless you also update volume mounts
DATABASE_URL=sqlite:////app/backend/data/curriculum_curator.db

# ── Local Mode ────────────────────────────────────────────
# Set to true for single-user/privacy mode (no login required)
LOCAL_MODE=false

# ── LLM API Keys (optional — users can also configure in-app) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Ollama (when using --profile local-ai) ────────────────
# Set to http://ollama:11434 when running ollama in the compose stack
OLLAMA_BASE_URL=http://localhost:11434

# ── Feature Flags ─────────────────────────────────────────
ENABLE_AI_FEATURES=true
ENABLE_FILE_UPLOAD=true
DEBUG=false

# ── Email (optional — enables password reset & invitations) ──
# Provider selects the transport. Options: resend, gmail, brevo, sendgrid,
# mailgun, postmark, custom (generic SMTP), dev (console output only).
# If required settings for the chosen provider are missing, the app falls
# back to dev mode and logs a warning at startup.
EMAIL_PROVIDER=dev
FROM_EMAIL=
FROM_NAME=Curriculum Curator

# Contact email advertised to third-party APIs (CrossRef/OpenAlex polite
# pools). Optional; falls back to FROM_EMAIL.
CONTACT_EMAIL=

# Resend (EMAIL_PROVIDER=resend — HTTP API, simplest)
RESEND_API_KEY=

# Generic SMTP (EMAIL_PROVIDER=custom; also username/password for gmail/brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
USE_TLS=true

# Other providers (set EMAIL_PROVIDER to match)
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
POSTMARK_SERVER_TOKEN=
